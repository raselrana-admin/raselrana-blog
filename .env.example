# Copy to .env.local and fill in. Git ignores .env.local; this file is committed.
# Every variable except the "Admin script" ones must also be set in the blog's
# own Vercel project (not the main site's), with the production values noted below.

# ── Database ─────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string, including the database name.
# The Prisma CLI reads its copy from .env, so keep the same value there.
DATABASE_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/raselrana-blog

# ── Cloudinary (image uploads) ───────────────────────────────────────────────
# Dashboard → Settings → API Keys. The secret signs uploads on the server only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder the uploads go into. Optional; defaults to raselrana-blog.
CLOUDINARY_UPLOAD_FOLDER=raselrana-blog

# ── Addresses ────────────────────────────────────────────────────────────────
# Must match basePath in next.config.mjs. Same value everywhere.
NEXT_PUBLIC_BASE_PATH=/blog
# The main site (raselrana-web). The blog asks it who is signed in to its
# dashboard, to let the owner into the blog admin (docs/blog-admin-handover.md).
# Here: http://localhost:3000 · Production: https://raselrana.com.bd
MAIN_SITE_URL=http://localhost:3000

# ── Auth.js (blog admin sign-in) ─────────────────────────────────────────────
# Signs the session cookie. Generate with: npx auth secret
# Use a different secret in production.
AUTH_SECRET=
# Where the auth routes are reached from the browser.
# Here: http://localhost:3000/api/auth · Production: https://raselrana.com.bd/blog/api/auth
AUTH_URL=http://localhost:3000/api/auth

# ── Launch switches ──────────────────────────────────────────────────────────
# true lets search engines index the public pages. Anything else: noindex.
BLOG_INDEXABLE=false
# Until this is true the production deployment shows the "coming soon" page.
# No effect here or on preview deployments, which always show the blog.
BLOG_LAUNCHED=false

# ── Admin script only (node src/scripts/create-admin.js) ─────────────────────
# Read by that script on this computer only. Never put these on Vercel.
# Password: at least 12 characters. The owner signs in through the main site
# instead (as super admin), so this account is for blog-only access.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Optional; part of the author page address. Defaults to the name without spaces.
ADMIN_USERNAME=
